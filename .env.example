# =========================================
#  Society Management API — Environment
# =========================================

# ---- Server ----
PORT=5000
NODE_ENV=development
JWT_SECRET=your-long-random-secret
APP_NAME=SocietyApp
FRONTEND_URL=http://localhost:5173

# ---- Database (local MySQL) ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=societyWeb
DB_DIALECT=mysql

# ---- Email / SMTP (Gmail App Password) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your-gmail@gmail.com
MAIL_PASS=your-16-char-gmail-app-password
MAIL_FROM=Society Management <your-gmail@gmail.com>

# ---- Razorpay (test keys) ----
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ---- Demo UPI Payment (for testing) ----
DEMO_UPI_ID=society@upi
DEMO_UPI_NAME=Green Valley Society

# ---- Cloudinary ----
CLOUD_NAME=your-cloud-name
CLOUD_KEY=your-cloudinary-api-key
CLOUD_SECRET=your-cloudinary-api-secret

# ---- Firebase (service account) ----
# JSON file: config/serviceAccountKey.json  (NOT committed to git)

# ---- Lease reminder cron (optional overrides) ----
# LEASE_REMINDER_CRON=0 9 * * *
# TZ=Asia/Kolkata

# ---- Production / Railway (use DATABASE_URL instead of DB_* above) ----
# DATABASE_URL=mysql://user:password@host:port/societyWeb
